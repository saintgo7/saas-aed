# ─────────────────────────────────────────
# Database (PostgreSQL on abada-65 Docker)
# ─────────────────────────────────────────
DATABASE_URL=postgresql://aed:CHANGE_ME@postgres:5432/aed

# ─────────────────────────────────────────
# Redis (session + BullMQ)
# ─────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─────────────────────────────────────────
# Auth.js v5 — Magic Link
# ─────────────────────────────────────────
NEXTAUTH_SECRET=CHANGE_ME_openssl_rand_base64_32
NEXTAUTH_URL=https://aed.abada.kr
AUTH_TRUST_HOST=true

# ─────────────────────────────────────────
# Cloudflare R2 (S3-compatible)
# ─────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=aed-inspection
R2_PUBLIC_URL=https://r2.aed.abada.kr

# ─────────────────────────────────────────
# Resend (transactional email)
# ─────────────────────────────────────────
RESEND_API_KEY=re_
RESEND_FROM=noreply@aed.abada.kr

# ─────────────────────────────────────────
# App
# ─────────────────────────────────────────
NODE_ENV=production
APP_URL=https://aed.abada.kr
APP_LOCALE_DEFAULT=ko

# ─────────────────────────────────────────
# Cron worker
# ─────────────────────────────────────────
CRON_TIMEZONE=Asia/Seoul
CRON_ENABLED=true

# ─────────────────────────────────────────
# DEMO MODE — bypass auth, auto-login as seeded ADMIN.
# ONLY for local dev or public demos. Never enable in production.
# ─────────────────────────────────────────
DEMO_MODE=false

# ─────────────────────────────────────────
# Backup (gpg recipient)
# ─────────────────────────────────────────
BACKUP_GPG_RECIPIENT=ops@abada.co.kr
BACKUP_R2_BUCKET=aed-backup
